{
  "name": "briko",
  "version": "0.0.2",
  "description": "A collection of utilities for managing LLM context and executor.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src/",
    "pretest": "pnpm build",
    "test": "mocha \"dist/**/*.spec.js\""
  },
  "keywords": [],
  "author": "Jimin Park",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/123jimin-llm/briko.git",
    "directory": "packages/briko"
  },
  "bugs": {
    "url": "https://github.com/123jimin-llm/briko/issues"
  },
  "homepage": "https://github.com/123jimin-llm/briko",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@google/genai": "^2.2.0",
    "@jiminp/tooltool": "^0.3.2",
    "arktype": "^2.2.0",
    "llm-msg-io": "workspace:*",
    "openai": "^6.37.0"
  }
}